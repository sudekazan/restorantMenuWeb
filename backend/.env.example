NODE_ENV=development
PORT=5050

MONGODB_URI=mongodb://127.0.0.1:27017/qr_restaurant

# En az 32 karakterlik rastgele bir değer kullanın: openssl rand -hex 32
JWT_SECRET=degistir_beni_cok_gizli_bir_anahtar
JWT_EXPIRES_IN=12h

# Veritabanındaki hassas alanları (tenant İyzico anahtarları) şifrelemek için
ENCRYPTION_SECRET=degistir_beni_32_karakterlik_sifreleme_anahtari

# Backend dış erişim adresi (İyzico callback URL üretimi için)
API_BASE_URL=http://localhost:5050

# Frontend adresleri (CORS) - virgülle ayırın
CLIENT_URLS=http://localhost:5173

# QR kodların yönlendireceği müşteri menüsü adresi: <PUBLIC_MENU_URL>/<qrToken>
PUBLIC_MENU_URL=http://localhost:5173/m

# İyzico Ayarları
# IYZICO_MODE: auto (anahtar varsa gerçek API, yoksa dev ortamında mock), live (zorunlu gerçek API), mock (simülasyon)
IYZICO_MODE=auto
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

UPLOAD_DIR=uploads
APP_TIMEZONE=Europe/Istanbul

# (Opsiyonel) PDF'lerde kullanılacak TTF font yolu. Boşsa assets/fonts/NotoSans-Regular.ttf kullanılır.
PDF_FONT_PATH=
